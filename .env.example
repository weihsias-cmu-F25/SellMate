# Agent API (do not commit real keys)
      OPENAI_API_KEY=sk-...your-key-here...

# IMPORTANT: the value must start with sk- (or sk-proj-).
# Do not put project names or other text before the key.

# Optional model overrides (used by server identify + listing)
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
PORT=3001

# Optional — live eBay sold comps via Finding API
# Get an App ID (Client ID) at https://developer.ebay.com/
# EBAY_APP_ID=